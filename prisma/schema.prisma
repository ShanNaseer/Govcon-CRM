// GovCon CRM / RFP Intelligence Platform — Prisma schema
//
// Design notes:
// - Multi-valued attributes (NAICS, PSC, keywords, certifications, ...) are modelled as
//   normalized child tables rather than delimited strings, so they can be indexed,
//   filtered and joined by the future matching engine.
// - The Opportunity model is provider-agnostic ("universal"). Provider payloads are
//   normalized before they reach this schema; the untouched payload is kept in `rawData`.
// - Money is stored as Decimal to avoid float rounding; it is serialized as a string at
//   the API boundary (see src/features/**/**.types.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
  ARCHIVED
}

enum KeywordType {
  POSITIVE
  NEGATIVE
}

/// Source system an opportunity was ingested from. Extend as providers are added.
///
/// This names the government system that published the solicitation, NOT the
/// aggregator it reached us through. Records pulled via HigherGov are stamped with
/// the upstream system its `source_type` reports (sam, dibbs, sbir, grant, sled), so
/// the inbox's Source filter means what a user expects it to mean. That an
/// aggregator was involved is recorded in `Opportunity.rawData`.
enum OpportunitySourceType {
  SAM_GOV
  BIDNET
  STATE_PORTAL
  /// Defense Logistics Agency's DIBBS.
  DIBBS
  /// Small Business Innovation Research / STTR solicitations.
  SBIR
  /// Federal grant opportunities (Grants.gov and equivalents).
  GRANTS
  MANUAL
  OTHER
}

/// Internal business workflow status. Deliberately separate from the publication
/// status reported by the source system (Opportunity.sourceStatus).
enum OpportunityStatus {
  NEW
  MATCHED
  REVIEWING
  INTERESTED
  PASSED
  PURSUING
  PROPOSAL_IN_PROGRESS
  SUBMITTED
  WON
  LOST
}

enum MatchRecommendation {
  PURSUE
  REVIEW
  PASS
}

enum MatchStatus {
  NEW
  REVIEWING
  SHORTLISTED
  DISMISSED
}

/// Kanban column on the tasks board.
enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Application role. Coarse-grained on purpose: per-client scoping is a separate
/// concern, handled by User.clientScope.
enum UserRole {
  ADMIN
  MANAGER
  MEMBER
}

// ---------------------------------------------------------------------------
// Client (a company profile used for opportunity matching)
// ---------------------------------------------------------------------------

model Client {
  id       String       @id @default(cuid())
  name     String
  initials String?
  industry String?
  status   ClientStatus @default(PROSPECT)

  // GovCon identifiers
  cageCode String?
  uei      String? @unique

  // Contact information
  website String?
  email   String?
  phone   String?
  city    String?
  state   String?

  // Matching profile
  capabilityDescription String?
  securityClearance     String?
  geographicPreferences String[] @default([])
  minContractValue      Decimal? @db.Decimal(14, 2)
  maxContractValue      Decimal? @db.Decimal(14, 2)

  naicsCodes        ClientNaicsCode[]
  pscCodes          ClientPscCode[]
  capabilities      ClientCapability[]
  keywords          ClientKeyword[]
  certifications    ClientCertification[]
  setAsides         ClientSetAside[]
  contractVehicles  ClientContractVehicle[]
  preferredAgencies ClientPreferredAgency[]
  matches           OpportunityMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@index([status])
  @@index([name])
}

model ClientNaicsCode {
  id        String  @id @default(cuid())
  clientId  String
  code      String
  title     String?
  isPrimary Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, code])
  @@index([code])
}

model ClientPscCode {
  id       String  @id @default(cuid())
  clientId String
  code     String
  title    String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, code])
  @@index([code])
}

model ClientCapability {
  id          String  @id @default(cuid())
  clientId    String
  name        String
  description String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, name])
}

model ClientKeyword {
  id       String      @id @default(cuid())
  clientId String
  keyword  String
  type     KeywordType
  weight   Int?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, keyword, type])
  @@index([keyword])
}

model ClientCertification {
  id        String    @id @default(cuid())
  clientId  String
  name      String
  issuedBy  String?
  expiresAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, name])
}

/// Set-aside programs the client qualifies for (8(a), WOSB, SDVOSB, HUBZone, ...).
/// Stored as a code plus optional label so new SBA program codes need no migration.
model ClientSetAside {
  id       String  @id @default(cuid())
  clientId String
  code     String
  label    String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, code])
  @@index([code])
}

model ClientContractVehicle {
  id             String    @id @default(cuid())
  clientId       String
  name           String
  contractNumber String?
  expiresAt      DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, name])
}

model ClientPreferredAgency {
  id       String @id @default(cuid())
  clientId String
  name     String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, name])
}

// ---------------------------------------------------------------------------
// Opportunity (universal, provider-agnostic)
// ---------------------------------------------------------------------------

model Opportunity {
  id String @id @default(cuid())

  source     OpportunitySourceType
  externalId String
  sourceUrl  String?

  title              String
  description        String?
  solicitationNumber String?

  agency    String?
  subAgency String?
  office    String?

  postedDate       DateTime?
  responseDeadline DateTime?

  setAside     String?
  contractType String?

  estimatedValueMin Decimal? @db.Decimal(14, 2)
  estimatedValueMax Decimal? @db.Decimal(14, 2)

  /// Capture manager's probability of win, 0-100. Null until someone assesses it,
  /// which is distinct from 0 — the dashboard's weighted pipeline treats an
  /// unassessed opportunity as contributing nothing rather than as a certain loss.
  probabilityOfWin Int?

  placeCity    String?
  placeState   String?
  placeCountry String?

  /// Who has taken this opportunity into their queue, and when.
  ///
  /// Null means nobody has claimed it, which is what puts a record in the shared
  /// inbox — the inbox is defined as the unclaimed pool, not as a status. An owner
  /// is tracked separately from `status` because the two answer different questions:
  /// INTERESTED says the team wants to pursue it, `assignedToId` says whose desk it
  /// is on. Without this column "My Queue" could only ever mean "everyone's queue".
  ///
  /// SetNull, not Cascade: removing a user must not delete the opportunities they
  /// were working, it must return them to the inbox for someone else to pick up.
  assignedToId String?
  assignedTo   User?     @relation("OpportunityOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  /// Who delegated it, when someone handed it to the holder rather than the holder
  /// claiming it themselves.
  ///
  /// Ownership stays SINGLE-VALUED — exactly one person is accountable for the work —
  /// while this records the supervisory interest. A manager who hands an opportunity
  /// to a colleague still needs it in their own queue to follow, so "My Queue" reads
  /// as assignedToId = me OR assignedById = me. Modelling that as two owners instead
  /// would make "whose job is this?" unanswerable.
  ///
  /// Null when the holder claimed it themselves, and cleared along with the holder
  /// when it returns to the inbox.
  assignedById String?
  assignedBy   User?     @relation("OpportunityDelegator", fields: [assignedById], references: [id], onDelete: SetNull)

  /// Internal workflow status.
  status       OpportunityStatus @default(NEW)
  /// Publication status as reported by the source system (e.g. "active", "archived").
  sourceStatus String?

  /// Provider's version identifier for this record, when it publishes one —
  /// HigherGov's `version_key`, which changes whenever the agency amends the
  /// solicitation and is stable otherwise.
  ///
  /// Purely an optimisation, and a large one: a re-sync compares this and skips the
  /// write entirely when it has not moved. Without it every re-sync rewrites every
  /// row it sees, which on a feed carrying thousands of records a day is most of the
  /// cost of syncing. Null means the provider gave no version, in which case the
  /// record is always rewritten — the safe direction.
  sourceVersion String?

  /// Normalized provider payload, retained for traceability and re-normalization.
  rawData Json?

  naicsCodes  OpportunityNaicsCode[]
  pscCodes    OpportunityPscCode[]
  attachments OpportunityAttachment[]
  matches     OpportunityMatch[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents duplicate imports of the same record from the same provider.
  @@unique([source, externalId])
  @@index([status])
  // Every "My Queue" read filters on this, and every inbox read filters on it
  // being null.
  @@index([assignedToId])
  // "My Queue" filters on either side of the delegation.
  @@index([assignedById])
  @@index([responseDeadline])
  @@index([postedDate])
  @@index([agency])
}

model OpportunityNaicsCode {
  id            String  @id @default(cuid())
  opportunityId String
  code          String
  title         String?
  isPrimary     Boolean @default(false)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([opportunityId, code])
  @@index([code])
}

model OpportunityPscCode {
  id            String  @id @default(cuid())
  opportunityId String
  code          String
  title         String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([opportunityId, code])
  @@index([code])
}

/// File metadata only. The bytes live in S3 (private bucket, presigned access).
model OpportunityAttachment {
  id            String @id @default(cuid())
  opportunityId String

  fileName    String
  contentType String?
  fileSize    Int?

  s3Bucket String
  s3Key    String

  sourceUrl String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([s3Bucket, s3Key])
  @@index([opportunityId])
}

/// How far a provider feed has been synced, so a run can catch up on its own.
///
/// Exists because the HigherGov API filters `captured_date` to an EXACT day rather
/// than "since": asking for today never returns yesterday's records, so a day nobody
/// synced is a permanent hole unless something remembers where we got to. Verified
/// against the live API — captured_date=2026-08-25 returns fewer records than
/// captured_date=2026-08-27, which it could not if the filter were cumulative.
///
/// One row per provider, keyed by name rather than by the source enum: a single
/// aggregator feed produces records under several `OpportunitySourceType` values, so
/// the enum is the wrong grain for a sync cursor.
model ProviderSyncState {
  /// Connector identifier, e.g. "highergov".
  provider String @id

  /// Last capture date (YYYY-MM-DD) fully imported, with no budget cutting it short.
  ///
  /// A date only lands here once every page for it has been stored. A run that stops
  /// at its record budget leaves this alone, so the next run resumes rather than
  /// stepping over the records it never fetched. Stored as a plain date string
  /// because that is exactly what the provider's parameter takes — converting to a
  /// timestamp and back would invite a timezone bug in a value that has no time.
  lastCapturedDate String?

  lastRunAt      DateTime?
  /// Counts from the most recent run, for the settings page. Diagnostics only.
  lastRunSummary Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

/// Join of Client x Opportunity produced by the matching pipeline.
/// Scores are nullable: rule scoring runs first, semantic/AI stages fill in later.
model OpportunityMatch {
  id            String @id @default(cuid())
  clientId      String
  opportunityId String

  ruleScore     Float?
  semanticScore Float?
  aiScore       Float?
  overallScore  Float?

  recommendation MatchRecommendation?
  matchReasons   String[]             @default([])
  risks          String[]             @default([])

  status MatchStatus @default(NEW)

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, opportunityId])
  @@index([clientId, overallScore])
  @@index([opportunityId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Authentication (application users and their server-side sessions)
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// Opaque, self-describing digest produced by src/lib/auth/password.ts.
  /// Never a raw or reversibly-encoded password.
  passwordHash String

  /// Permission role — a closed set, and the only thing authorization reads.
  /// Deliberately separate from `jobTitle`: the reference design uses one free-text
  /// "role" field for both the job someone does and what they may access, which
  /// makes permissions unenforceable.
  role UserRole @default(MEMBER)

  /// Human-facing job title, e.g. "Proposal Manager". Display only.
  jobTitle   String?
  department String?
  phone      String?

  /// Disabling a user blocks sign-in and invalidates existing sessions without
  /// destroying the audit trail a deletion would take with it.
  isActive Boolean @default(true)

  /// Per-client authorization. `allClients` grants unrestricted access; otherwise
  /// only the Clients listed in `clientIds` are visible. Default is deny-all, so a
  /// user created without explicit scope sees nothing rather than everything.
  allClients Boolean  @default(false)
  clientIds  String[] @default([])

  lastLoginAt DateTime?

  sessions      Session[]
  assignedTasks Task[]    @relation("TaskAssignee")
  createdTasks  Task[]    @relation("TaskCreator")

  /// Opportunities this person has taken into their queue.
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")

  /// Opportunities this person handed to someone else, which stay in their queue.
  delegatedOpportunities Opportunity[] @relation("OpportunityDelegator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// Server-side session. Sessions are stored rather than signed into the cookie so
/// that sign-out and user deactivation take effect immediately.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the session token. The token itself exists only in the client's
  /// cookie, so a database disclosure does not hand over usable sessions.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  /// Coarse request provenance, kept for audit. Not used for authorization: both
  /// values are client-controlled and trivially spoofed.
  userAgent String?
  ipAddress String?

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A permission granted to a role, editable at runtime from /team/permissions.
///
/// One row per grant rather than a `String[]` column on a role table, for two
/// reasons: toggling one checkbox is an insert or a delete rather than a
/// read-modify-write of an array (so two administrators editing different cells
/// cannot overwrite each other), and each grant carries its own audit trail.
///
/// ABSENCE IS DENIAL. A permission removed from `PERMISSIONS` in
/// src/lib/auth/permissions.ts therefore stops being granted without needing a data
/// migration, and a role with no rows can do nothing. The one exception is an
/// entirely empty table, which src/lib/auth/role-permissions.ts reads as "not yet
/// configured" and answers from the code defaults — otherwise deploying this
/// migration would lock every user out until someone seeded it.
model RolePermission {
  role UserRole

  /// Matches a value of `Permission` in src/lib/auth/permissions.ts. Deliberately
  /// a String and not an enum: the permission set changes with the feature set, and
  /// an enum would make every new capability a migration. Unrecognised values are
  /// discarded on read, so a stale row cannot grant anything.
  permission String

  grantedAt DateTime @default(now())

  /// User who granted it. SetNull-equivalent by being a plain id rather than a
  /// relation: deleting an administrator must not delete the grants they made, and
  /// this column is for the audit trail only, never for authorization.
  grantedById String?

  @@id([role, permission])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Task (work items across the capture, proposal and delivery lifecycle)
// ---------------------------------------------------------------------------

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  /// Nullable: not every task is time-boxed. The board treats an absent due date
  /// as "no deadline" rather than as overdue.
  dueDate DateTime?

  /// Set when the task first enters DONE, and cleared if it moves back out, so it
  /// records when the work actually finished rather than when the row last changed.
  completedAt DateTime?

  tags String[] @default([])

  /// Assignment is a real relation rather than the reference design's free-text
  /// name, because this application has actual user records. SetNull, not Cascade:
  /// deleting a user must not delete their team's work.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Optional link to the record the task is about. The reference design also
  /// offers proposals and projects; those domains do not exist here yet, so a task
  /// attaches to an Opportunity or a Client or to nothing at all.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assigneeId])
  @@index([opportunityId])
  @@index([clientId])
}
