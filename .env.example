# Copy to .env and fill in. Never commit .env or real credentials.

# App
NEXT_PUBLIC_APP_NAME="GovCon CRM"
APP_URL="http://localhost:3000"

# Database — must point at a reachable PostgreSQL instance before running migrations.
#
# AWS RDS (provision with ./scripts/aws/provision-rds.sh):
#   DATABASE_URL="postgresql://USER:PASSWORD@INSTANCE.abcdefg.REGION.rds.amazonaws.com:5432/govcon_crm?sslmode=require"
# Local PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?sslmode=disable"
#
# Keep sslmode at `require` for RDS: the Prisma CLI's schema engine does not accept
# libpq's `verify-full`. Certificate verification for the application connection is
# switched on separately by DATABASE_CA_CERT_PATH below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional scratch database used by `prisma migrate dev` to detect schema drift.
# Leave unset to let Prisma create one automatically; set it when the database user
# cannot CREATE DATABASE (managed instances), or when using `prisma dev`, which
# publishes its own shadow database on the next port up.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_shadow?sslmode=require"

# Path to a CA bundle. When set, the app verifies the database server's certificate
# and hostname instead of merely encrypting the connection. For RDS, download the
# Amazon global bundle with `npm run db:ca`, which writes the path below.
DATABASE_CA_CERT_PATH="certs/rds-global-bundle.pem"

# AWS
AWS_REGION=""
AWS_S3_BUCKET=""

# Optional, LOCAL DEVELOPMENT ONLY.
# In deployed environments leave these unset and rely on IAM roles / the default
# AWS credential provider chain instead of long-lived access keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Presigned URL lifetime in seconds (default 900 = 15 minutes).
S3_PRESIGNED_URL_TTL_SECONDS="900"
