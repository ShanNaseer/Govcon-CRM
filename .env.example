# Copy to .env and fill in. Never commit .env or real credentials.

# App
NEXT_PUBLIC_APP_NAME="GovCon CRM"
APP_URL="http://localhost:3000"

# Database — must point at a reachable PostgreSQL instance before running migrations.
#
# AWS RDS (provision with ./scripts/aws/provision-rds.sh):
#   DATABASE_URL="postgresql://USER:PASSWORD@INSTANCE.abcdefg.REGION.rds.amazonaws.com:5432/govcon_crm?sslmode=require"
# Local PostgreSQL:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?sslmode=disable"
#
# Keep sslmode at `require` for RDS: the Prisma CLI's schema engine does not accept
# libpq's `verify-full`. Certificate verification for the application connection is
# switched on separately by DATABASE_CA_CERT_PATH below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional scratch database used by `prisma migrate dev` to detect schema drift.
# Leave unset to let Prisma create one automatically; set it when the database user
# cannot CREATE DATABASE (managed instances), or when using `prisma dev`, which
# publishes its own shadow database on the next port up.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_shadow?sslmode=require"

# Path to a CA bundle. When set, the app verifies the database server's certificate
# and hostname instead of merely encrypting the connection. For RDS, download the
# Amazon global bundle with `npm run db:ca`, which writes the path below.
DATABASE_CA_CERT_PATH="certs/rds-global-bundle.pem"

# AWS
AWS_REGION=""
AWS_S3_BUCKET=""

# Optional, LOCAL DEVELOPMENT ONLY.
# In deployed environments leave these unset and rely on IAM roles / the default
# AWS credential provider chain instead of long-lived access keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Presigned URL lifetime in seconds (default 900 = 15 minutes).
S3_PRESIGNED_URL_TTL_SECONDS="900"

# HigherGov opportunity feed (https://www.highergov.com/api-external/docs/).
#
# Without HIGHERGOV_API_KEY the application runs normally and the inbox reports that
# no feed is configured — only the sync endpoint is disabled. The key travels as a
# query parameter because that is how the API is specified, so it is redacted from
# every log line (see src/integrations/opportunities/highergov/highergov.client.ts).
HIGHERGOV_API_KEY="125f528fce1945bc982dd37bd9f38a4e"

# Optional overrides.
# HIGHERGOV_BASE_URL=https://www.highergov.com
# Records per request; the API caps this at 100.
# HIGHERGOV_PAGE_SIZE=100
# Ceiling on pages per day per sync run, so one call cannot page indefinitely.
# HIGHERGOV_MAX_PAGES=20

# Records and pages per sync RUN (not per day). The unfiltered feed captures several
# thousand records a day, so a run does a bounded batch and reports what remains.
# HIGHERGOV_MAX_PAGES=5
# HIGHERGOV_MAX_RECORDS=500

# Saved-search id from the HigherGov UI. THE SETTING THAT MATTERS: unfiltered, this
# feed carries every federal, DIBBS, SBIR, grant and state/local solicitation. A saved
# search moves NAICS/PSC/agency/value filtering to the provider so a sync returns a
# pipeline instead of a firehose.
# HIGHERGOV_SEARCH_ID=

# Days re-covered on every sync, counting today. Not redundancy: records are captured
# throughout the day, so a morning run cannot have seen the afternoon's, and an
# amendment is re-captured under a later date. Cheap to store (unchanged records are
# skipped on sourceVersion); still costs one fetch per page.
# HIGHERGOV_OVERLAP_DAYS=3

# Which imported opportunities are kept. Applied AFTER fetching, because the HigherGov
# opportunity endpoint has no NAICS or PSC parameter — this keeps the inbox relevant
# but does not make a sync faster. Use HIGHERGOV_SEARCH_ID to narrow what is fetched.
#
# Unset uses the built-in IT profile (NAICS 5415/5182/5112/5132/5162/5192/517/3341/
# 6114/8112, PSC D/70/7A-7J/5820/5895).
# OPPORTUNITY_FILTER_ENABLED=true
# OPPORTUNITY_NAICS_PREFIXES=5415,5182,5132
# OPPORTUNITY_PSC_PREFIXES=D,70,7A
# Keep records that carry no NAICS and no PSC at all. False by default: most such
# records on this feed are state/local notices, and letting them through would defeat
# the filter for the bulk of the volume.
# OPPORTUNITY_KEEP_UNCLASSIFIED=false
